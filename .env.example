# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# any long random string (32+ chars). Generate one with: openssl rand -hex 32
SESSION_SECRET=
# optional view-only account (board only). Defaults: user / same password as admin
VIEWER_USERNAME=user
VIEWER_PASSWORD=
# From Supabase → Project Settings → API. Leave both empty to store data in a local file (.data/) instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
